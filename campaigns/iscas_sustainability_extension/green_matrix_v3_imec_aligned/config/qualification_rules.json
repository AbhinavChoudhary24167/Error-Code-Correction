    {
      "metric_id": "MRCC_MATCHED_BASELINE",
      "requirements": [
        {"quantity": "matched_lifecycle_carbon", "minimum_tier": "E2", "allowed_classes": ["ABSOLUTE_QUALIFIED", "RELATIVE_QUALIFIED"]},
        {"quantity": "matched_correct_service", "minimum_tier": "E2", "allowed_classes": ["ABSOLUTE_QUALIFIED", "RELATIVE_QUALIFIED", "BOUNDED"]}
      ],
      "permits_parametric": false
    }
  ]
}
