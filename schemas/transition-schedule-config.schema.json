{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://green-ecc.local/schemas/transition-schedule-config.schema.json",
  "title": "GREEN-ECC transition-aware study configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "study_id", "model_status", "modes", "designs",
    "transition_costs", "policy", "trace_generators", "uncertainty_samples"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {"type": "string", "minLength": 1},
    "model_status": {"enum": ["synthetic_sensitivity", "analytical", "characterized_input"]},
    "modes": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "designs": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "transition_costs": {"type": "object"},
    "policy": {"type": "object"},
    "traces": {"type": "array", "items": {"type": "object"}},
    "trace_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "trace_generators": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "uncertainty_samples": {"type": "integer", "minimum": 1},
    "uncertainty_seed": {"type": "integer"},
    "certificate_gate": {
      "type": "object",
      "required": ["enabled", "ambiguity_type", "maximum_sdc", "support_id_by_fault_regime"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ambiguity_type": {"enum": ["total_variation", "structured_interval", "geometry_wasserstein"]},
        "maximum_sdc": {"type": "number", "minimum": 0, "maximum": 1},
        "strict_deployment_validation": {"type": "boolean"},
        "epoch_out_of_support_probability_key": {"type": "string", "minLength": 1},
        "minimum_certificate_version": {"type": "integer", "minimum": 1},
        "epoch_radius_uncertainty_key": {"type": "string", "minLength": 1},
        "support_id_by_fault_regime": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "certificate_envelopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mode_id", "ambiguity_type", "support_identifier", "certified_radius", "maximum_certified_sdc", "maximum_certified_due", "fallback_mode", "certificate_identifier", "supported_fault_regimes"],
        "properties": {
          "mode_id": {"type": "string", "minLength": 1},
          "ambiguity_type": {"enum": ["total_variation", "structured_interval", "geometry_wasserstein"]},
          "support_identifier": {"type": "string", "minLength": 1},
          "certified_radius": {"type": "number", "minimum": 0},
          "maximum_certified_sdc": {"type": "number", "minimum": 0, "maximum": 1},
          "maximum_certified_due": {"type": "number", "minimum": 0, "maximum": 1},
          "fallback_mode": {"type": "string", "minLength": 1},
          "certificate_identifier": {"type": "string", "minLength": 1},
          "maximum_out_of_support_probability": {"type": "number", "minimum": 0, "maximum": 1},
          "certificate_verification_status": {"enum": ["passed", "failed", "not_run"]},
          "certificate_integrity_valid": {"type": "boolean"},
          "certificate_sha256": {"type": "string", "minLength": 1},
          "certificate_version": {"type": "integer", "minimum": 1},
          "is_certified_fallback": {"type": "boolean"},
          "supported_fault_regimes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "sweeps": {"type": "object"}
  }
}
