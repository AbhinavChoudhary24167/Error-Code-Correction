{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://green-ecc.local/schemas/schedule-result.schema.json",
  "title": "GREEN-ECC transition-aware schedule result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "study_id", "objective", "validation_level", "trace_results",
    "joint_decisions", "hypotheses", "deployment_policy", "provenance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {"type": "string"},
    "objective": {"enum": ["lifecycle_energy_j", "lifecycle_carbon_kgco2e"]},
    "validation_level": {"type": "string"},
    "trace_results": {"type": "object"},
    "joint_decisions": {"type": "object"},
    "hypotheses": {"type": "object"},
    "regime_sweep": {"type": "object"},
    "scalability": {"type": "array"},
    "figure_takeaways": {"type": "object"},
    "deployment_policy": {"type": "object"},
    "provenance": {"type": "object"}
  }
}
