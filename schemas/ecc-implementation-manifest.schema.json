{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://green-ecc.local/schemas/ecc-implementation-manifest.schema.json",
  "title": "GREEN-ECC-PHY ECC hardware implementation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "implementation_id", "code_id", "version", "source_files", "encoder_top",
    "decoder_top", "wrapper_module", "configuration_modules", "parameters", "architecture_style",
    "pipeline_stages", "initiation_interval", "encoder_latency", "decoder_latency", "clock_reset",
    "transaction_protocol", "output_status_semantics", "decoder_policy_id", "metadata_requirements",
    "mux_requirements", "controller_requirements", "reencoding_requirements",
    "compatible_deployment_architectures", "adapter", "verification_vectors", "verification_evidence",
    "capability_claims", "source_provenance", "license", "source_hashes", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "code_spec_id": {"type": "string", "minLength": 1},
    "encoder_id": {"type": "string", "minLength": 1},
    "implementation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "code_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "encoder_top": {"type": ["string", "null"]},
    "decoder_top": {"type": ["string", "null"]},
    "wrapper_module": {"type": ["string", "null"]},
    "configuration_modules": {"type": "array", "items": {"type": "string"}},
    "parameters": {"type": "object"},
    "architecture_style": {"enum": ["combinational", "sequential", "pipelined", "reference_only"]},
    "pipeline_stages": {"type": "integer", "minimum": 0},
    "initiation_interval": {"type": "integer", "minimum": 1},
    "encoder_latency": {"type": "integer", "minimum": 0},
    "decoder_latency": {"type": "integer", "minimum": 0},
    "clock_reset": {"type": "object"},
    "transaction_protocol": {"type": "object"},
    "output_status_semantics": {"type": "object"},
    "decoder_policy_id": {"type": "string", "minLength": 1},
    "metadata_requirements": {"type": "object"},
    "mux_requirements": {"type": "object"},
    "controller_requirements": {"type": "object"},
    "reencoding_requirements": {"type": "object"},
    "compatible_deployment_architectures": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "adapter": {
      "type": "object", "additionalProperties": false, "required": ["factory", "parameters"],
      "properties": {"factory": {"type": "string", "minLength": 3}, "parameters": {"type": "object"}}
    },
    "verification_vectors": {"type": "object"},
    "verification_evidence": {"type": "array", "items": {"type": "object"}},
    "capability_claims": {"type": "object"},
    "verified_capabilities": {"type": "array", "items": {"type": "string"}},
    "failed_capabilities": {"type": "array", "items": {"type": "string"}},
    "unsupported_capabilities": {"type": "array", "items": {"type": "string"}},
    "backend_id": {"type": ["string", "null"]},
    "evidence_level": {"type": "string"},
    "source_provenance": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "license": {"type": "string", "minLength": 1},
    "source_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
