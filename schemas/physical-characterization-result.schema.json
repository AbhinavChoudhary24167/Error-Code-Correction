{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://green-ecc.local/schemas/physical-characterization-result.schema.json",
  "title": "GREEN-ECC-PHY normalized physical characterization result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "result_id", "code_id", "implementation_id", "architecture_id", "backend_id",
    "technology", "pdk", "library", "corner", "voltage", "temperature", "timing_constraints",
    "workload_id", "k", "n", "redundancy", "cell_area", "routed_area", "critical_path",
    "setup_slack", "hold_slack", "maximum_frequency", "encoder_latency", "decoder_latency",
    "initiation_interval", "encoder_energy", "no_error_decode_energy", "corrected_decode_energy",
    "due_decode_energy", "leakage_power", "mux_area", "mux_energy", "controller_area",
    "controller_energy", "metadata_bits", "transition_energy", "transition_latency",
    "reencoding_energy", "wirelength", "congestion", "uncertainty", "evidence_level",
    "provenance", "unsupported_fields", "structural_metrics", "result_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "result_id": {"type": "string", "minLength": 1},
    "code_id": {"type": "string"}, "implementation_id": {"type": "string"},
    "architecture_id": {"type": ["string", "null"]}, "backend_id": {"type": "string"},
    "technology": {"type": ["string", "null"]}, "pdk": {"type": ["string", "null"]},
    "library": {"type": ["string", "null"]},
    "corner": {"type": ["string", "null"]}, "voltage": {"type": ["number", "null"]},
    "temperature": {"type": ["number", "null"]}, "timing_constraints": {"type": ["object", "null"]},
    "workload_id": {"type": ["string", "null"]},
    "k": {"type": "integer"}, "n": {"type": "integer"}, "redundancy": {"type": "integer"},
    "cell_area": {"type": ["number", "null"]}, "routed_area": {"type": ["number", "null"]},
    "critical_path": {"type": ["number", "null"]}, "setup_slack": {"type": ["number", "null"]},
    "hold_slack": {"type": ["number", "null"]}, "maximum_frequency": {"type": ["number", "null"]},
    "encoder_latency": {"type": ["integer", "null"]}, "decoder_latency": {"type": ["integer", "null"]},
    "initiation_interval": {"type": ["integer", "null"]},
    "encoder_energy": {"type": ["number", "null"]}, "no_error_decode_energy": {"type": ["number", "null"]},
    "corrected_decode_energy": {"type": ["number", "null"]}, "due_decode_energy": {"type": ["number", "null"]},
    "leakage_power": {"type": ["number", "null"]}, "mux_area": {"type": ["number", "null"]},
    "mux_energy": {"type": ["number", "null"]}, "controller_area": {"type": ["number", "null"]},
    "controller_energy": {"type": ["number", "null"]}, "metadata_bits": {"type": ["integer", "null"]},
    "transition_energy": {"type": ["number", "null"]}, "transition_latency": {"type": ["number", "null"]},
    "reencoding_energy": {"type": ["number", "null"]}, "wirelength": {"type": ["number", "null"]},
    "congestion": {"type": ["number", "null"]}, "uncertainty": {"type": ["object", "null"]},
    "evidence_level": {"enum": ["physical_characterized", "post_route", "post_synthesis_characterized", "structural_only", "not_characterized"]},
    "provenance": {"type": "object"},
    "unsupported_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "structural_metrics": {"type": ["object", "null"]},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
